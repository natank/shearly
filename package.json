    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:geocoder-stub": "node --test tools/geocoder-stub/server.spec.mjs",
    "check:i18n": "node scripts/check-hardcoded-strings.mjs",
    "check:rtl": "node scripts/check-physical-styles.mjs apps/web apps/admin libs/ui",
    "check:placeholder-text": "node scripts/check-placeholder-text.mjs",
    "e2e": "nx e2e web-e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@nx/eslint": "^23.1.1",
    "@nx/eslint-plugin": "^23.1.1",
    "@nx/js": "^23.1.1",
    "@nx/vitest": "^23.1.1",
    "@playwright/test": "^1.62.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "nx": "^23.1.1",
    "pg": "^8.23.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.2",
    "next": "^15.5.23",
    "next-intl": "^4.13.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
