{
  "name": "shearly",
  "version": "0.0.1",
  "private": true,
  "description": "On-demand marketplace for home beauty services",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
